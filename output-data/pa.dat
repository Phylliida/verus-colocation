1ll2|n|	a:gfz,64,2;1qwn,62,11;rqb,59,93;169f,58,4;3ff,56,3;22vf,54,34;zqt,50,11;2cv6,50,7;1cmc,49,33;2528,48,10;wdd,48,20;1k6,45,2;pgs,43,4;1qwp,42,72;y7,42,2~1jjn,23,524;lsa,23,268;1bzd,13,135;13f7,25,124;1uyp,32,115;cni,31,112;18y3,33,107;rqb,59,93;21v0,28,92;1foo,29,80;1qwp,42,72;2e9v,34,69;22zk,14,66;203w,14,38;14es,24,35	v:28uz,75,2;1epa,74,9;qiv,61,6;1qwp,61,259;ezm,49,18;l1r,47,18;1w8d,47,2;1w29,45,6;1fh0,45,98;1x1a,40,4;1w26,38,10;1lo7,38,3;j7k,31,5;9w5,28,7;gjh,26,5~1qwp,61,259;1fh0,45,98;1qwm,10,28;1ecy,24,25;1r4o,25,22;1v56,13,19;l1r,47,18;ezm,49,18;h17,8,14;1w26,38,10;1vt5,17,10;x7w,17,10;1epa,74,9;l1c,7,8;1fgx,21,8	V:22pv,70,15;gxp,51,39;28rx,43,4;1qwp,30,32;1r4p,18,5;str,16,2;uhe,9,11;1ecy,9,9;ta8,7,6;7d1,3,10;1gj8,2,9;hzk,2,5;1zcs,1,17;l1m,0,3~gxp,51,39;1qwp,30,32;1zcs,1,17;22pv,70,15;uhe,9,11;7d1,3,10;1ecy,9,9;1gj8,2,9;ta8,7,6;1r4p,18,5;hzk,2,5;28rx,43,4;l1m,0,3;str,16,2	n:gfz,64,2;1yvz,62,7;22vf,54,33;1vc4,53,41;1dbc,50,34;28v1,45,6;toj,45,12;1xqv,41,2;11oa,38,24;1ogt,36,20;95j,35,31;ao,34,15;y7,32,1;1q5e,32,7;1vnz,30,8~1vc4,53,41;1qwq,20,35;1dbc,50,34;22vf,54,33;95j,35,31;11oa,38,24;1oae,29,24;1qwv,16,21;1ogt,36,20;1qwm,5,19;ao,34,15;28dx,2,13;toj,45,12;h3q,20,10;2g8i,3,10	N:28rx,49,6~28rx,49,6
