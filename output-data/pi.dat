1jx9|n|A mass of type confusedly mixed or unsorted.	a:1phv,77,35;tli,37,3;uih,31,6;hnu,18,6;1dh9,3,5~1phv,77,35;hnu,18,6;uih,31,6;1dh9,3,5;tli,37,3	v:1phv,42,3~1phv,42,3	V:1sv5,40,11;29xc,39,6;6l1,13,4;4z7,7,2~1sv5,40,11;29xc,39,6;6l1,13,4;4z7,7,2	n:1phv,103,208;9nh,66,6;1ffv,52,2;15nm,20,2~1phv,103,208;9nh,66,6;15nm,20,2;1ffv,52,2	N:10gy,116,7;1frm,76,12;ajk,66,14;2brw,65,30;yqi,41,3;aox,26,8;b8i,4,4~2brw,65,30;ajk,66,14;1frm,76,12;aox,26,8;10gy,116,7;b8i,4,4;yqi,41,3
