1ixs|n|One employed to steer a vessel; a helmsman; a steersman. ; Specifically, a person duly qualified, and licensed by authority, to conduct vessels into and out of a port, or in certain waters, for a fixed rate of fees. ; Figuratively: A guide; a director of another through a difficult or unknown course. ; An instrument for detecting the compass error. ; The cowcatcher of a locomotive.	a:1a55,90,4;iqm,77,1;2642,77,2;1z7s,61,5;uf,60,5;a0e,60,3;10hm,56,4;262c,54,6;9rz,49,7;5gx,49,3;m25,48,1;24z6,44,5;1mhb,42,3;i27,40,2;1bzx,37,5~1lnv,12,53;e1v,24,26;19lf,25,15;1zhl,29,8;qdc,5,8;1luk,1,8;9rz,49,7;1mzj,1,7;q05,34,7;1ndt,18,7;src,13,7;1cqs,0,6;11cb,37,6;262c,54,6;2l9,3,5	v:iqm,87,2;m25,48,1;10hm,46,2;a0e,44,1;bnc,37,3;1t18,37,2;q21,33,11;jbd,33,8;19rr,31,1;1v3n,31,6;i27,30,1;262c,28,1;1o5b,20,6;13gl,19,3;mak,16,3~q21,33,11;jbd,33,8;10au,4,8;1v3n,31,6;1o5b,20,6;1pbv,0,5;1fcs,10,5;1osy,6,4;mak,16,3;bnc,37,3;13gl,19,3;6wq,0,3;bnf,8,2;1t18,37,2;85h,1,2	V:1lfb,68,3;izu,60,5;61y,59,3;nck,47,4;e02,44,3;28yv,44,4;51m,44,2;n9p,39,8;253t,38,4;1pc7,38,1;r6,37,5;11r7,34,5;e4p,34,3;s76,33,9;1t1d,32,6~shd,15,28;1o5b,31,13;fdp,16,9;s76,33,9;1ofp,9,9;1v04,14,8;n9p,39,8;1czs,2,8;i5z,29,7;5cy,21,7;1hlx,11,7;1t6s,20,7;i3z,14,7;15le,9,6;16vz,2,6	n:1wve,61,5;1yiz,53,5;4xw,51,3;16qv,48,5;22xk,46,10;1x1e,46,24;2774,46,2;rp1,45,36;a0e,44,1;cw9,43,4;uzo,40,21;rhc,38,3;1lv1,37,4;c6z,35,5;652,32,7~rp1,45,36;1yhg,3,28;1rls,20,25;1lnv,1,24;1x1e,46,24;uzo,40,21;13rx,11,11;126d,14,10;22xk,46,10;23bb,15,9;126b,14,8;1ptr,26,7;652,32,7;i0,20,7;1w0h,21,6	N:10ho,71,7;11ca,64,4;cnc,54,8;e84,53,5;1udp,44,4;pxj,41,7;77,40,4;39r,38,5;1lv0,36,6;1ijl,35,3;28h4,34,4;51m,34,1;1eb,32,3;17eu,30,6;1lwn,30,6~161e,20,22;bnb,15,21;233c,5,19;1t1c,3,10;bne,29,10;1v3m,21,9;cnc,54,8;1rls,4,8;27if,18,7;gnj,10,7;1vf5,11,7;pxj,41,7;126b,12,7;10ho,71,7;1lv0,36,6
