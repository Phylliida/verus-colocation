8dp|n|	a:qme,48,4;1py7,48,5;1w35,41,7;1j8m,29,3;es,18,3;1gtw,15,3~1w35,41,7;1py7,48,5;qme,48,4;1j8m,29,3;1gtw,15,3;es,18,3	V:jqz,58,3;1lzb,40,4~1lzb,40,4;jqz,58,3	n:qng,38,4;1uno,28,7;1n1q,13,6~1uno,28,7;1n1q,13,6;qng,38,4	N:1gty,67,3;pbn,67,2;1lw7,66,102;pbu,65,6;1lzb,62,19~1lw7,66,102;1lzb,62,19;pbu,65,6;1gty,67,3;pbn,67,2
