8jux|a|of Settle	j:7iy,59,7;9b15,56,1;2plf,56,1;79r1,44,5;8tgc,44,4;1ayb,41,26;368i,35,2;3iwi,35,14;3ep9,32,1;1paj,31,6;91xd,24,89;79qw,23,12;1sec,23,6;3j97,23,2;ieh,20,17~91xd,24,89;4p7w,4,64;5mea,10,40;1ayb,41,26;ieh,20,17;3iwi,35,14;79qw,23,12;555n,2,11;53j9,10,9;6onj,1,8;7iy,59,7;9swr,8,6;1sec,23,6;1paj,31,6;1qu7,6,6	e:8whk,73,7;2be9,55,5;3aeq,44,3;56ho,11,2;9rhn,3,9~9rhn,3,9;8whk,73,7;2be9,55,5;3aeq,44,3;56ho,11,2
