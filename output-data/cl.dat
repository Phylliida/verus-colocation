1l91|n|A collection of visible vapor, or watery particles, suspended in the upper atmosphere. ; A mass or volume of smoke, or flying dust, resembling vapor. ; A dark vein or spot on a lighter material, as in marble; hence, a blemish or defect; as, a cloud upon one's reputation; a cloud on a title. ; That which has a dark, lowering, or threatening aspect; that which temporarily overshadows, obscures, or depresses; as, a cloud of sorrow; a cloud of war; a cloud upon the intellect. ; A great crowd or multitude; a vast collection. ; A large, loosely-knitted scarf, worn by women about the head.	a:5h76,119,228;7hu7,100,14;9l7a,96,7;6d6s,95,6;7odd,93,4;4znm,92,11;20ux,90,17;258v,89,16;6nsb,89,104;20v0,89,47;56zd,88,20;4slt,88,28;5z2s,87,9;7hu1,86,3;9pw,85,3~3sts,58,10355;7ex5,19,1198;7j6e,3,1103;1yit,69,965;aln0,65,804;9dku,20,757;3dnz,79,551;3go7,15,482;6tfq,4,443;2pd1,59,441;6wwq,26,378;71ra,23,266;wyo,7,244;5xe9,54,232;5h76,119,228	v:937x,97,164;5kog,95,5551;17pr,74,1;4bsq,69,125;6440,69,1;xeu,64,3;8g5j,62,2;8y4h,57,2;2yp,56,12;9j7,56,8;5yk0,53,1;5k4i,52,3;6nsb,52,8;7odc,46,21;zd0,45,11~5kog,95,5551;3sts,11,404;937x,97,164;4bsq,69,125;5j0y,10,119;33e8,20,50;8yfw,1,49;1nep,44,45;aln0,18,31;45u5,7,28;927u,13,27;2t3s,0,22;7odc,46,21;3dnz,25,13;2yp,56,12	V:5r0t,94,3741;5r1g,87,6;6t28,87,73;3b2u,66,4;2i9w,63,8;5lbn,58,141;5lc9,57,144;2xr8,56,8;1qin,55,1152;45ve,50,653;5e4j,50,6;45u5,50,549;8f5h,49,33;1nei,49,55;6ozf,46,45~sbb,36,3863;5r0t,94,3741;1qin,55,1152;45ve,50,653;45u5,50,549;8acl,2,207;5lc9,57,144;5lbn,58,141;8q7t,12,139;9aeb,29,82;6t28,87,73;5d4r,7,65;1x3p,11,57;5xto,22,56;1nei,49,55	n:6nsb,119,863;7odc,110,1761;48mx,107,82;2kea,99,30;2yp,92,138;5wef,91,11;77zg,90,7;ap0y,90,506;atu9,90,6;gp,87,34;928f,87,4;bg5,83,7;5yk0,81,7;9ylx,81,6;1de6,81,6~788m,40,10072;3sts,54,8177;pyl,70,2625;7odc,110,1761;8i6l,25,1292;2t3s,58,1180;5kog,72,1172;6nsb,119,863;33lz,31,863;927u,62,836;3kq6,46,819;bfw,55,799;7ex5,9,606;alxf,14,580;ap0y,90,506	N:25ln,102,8;3b2u,93,25;2wuw,87,11;3ft