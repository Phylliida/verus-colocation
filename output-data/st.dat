24gy|n|	a:xxl,103,47;1n3c,42,1;2dwb,6,1~xxl,103,47;2dwb,6,1;1n3c,42,1	v:xxl,68,4;1cyl,18,1;2dwb,6,1~xxl,68,4;2dwb,6,1;1cyl,18,1	V:22zt,66,7;2h01,18,18~2h01,18,18;22zt,66,7	n:xxl,100,38;1n3c,88,24;27kt,70,5;ao,64,6;2bl7,63,5;1cyl,60,18;2dwb,56,31;u7p,54,16;197i,51,18;1oae,49,5;1qwm,46,18;1el9,22,5;22h2,20,7~xxl,100,38;2dwb,56,31;1n3c,88,24;1qwm,46,18;1cyl,60,18;197i,51,18;u7p,54,16;22h2,20,7;ao,64,6;1el9,22,5;27kt,70,5;2bl7,63,5;1oae,49,5
